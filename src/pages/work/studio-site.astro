---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import ArrowUpRight from "@northsoon/phosphor-icons-astro/icons/ArrowUpRight.astro";
import { SITE_URL } from "@/data/site-config";
---

<BaseLayout
  title="Studio site · Northsoon"
  description="The Northsoon studio site is being rebuilt from scratch. Status, scope, and where to find the previous version."
  canonical={`${SITE_URL}/work/studio-site`}
>
  <div class="flex min-h-screen flex-col bg-background text-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink />

      <header class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
            Work · Studio site
          </p>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
            Studio site
          </h1>
        </div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
          in dev
        </span>
      </header>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-muted-foreground">
        <p>
          The page you're on now is a temporary, brand-aligned placeholder
          while Northsoon's full studio site gets rebuilt from scratch.
        </p>
        <p>
          The new site will introduce a proper studio surface, including
          case studies, services, and a writing section, on top of the new
          brand identity (palette, mountain mark, Geist typography).
        </p>
        <p>
          The previous version of the site is still online for reference:
        </p>
        <p>
          <a
            href="https://old.northsoon.com"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 text-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            <span class="font-medium">old.northsoon.com</span>
            <ArrowUpRight size={12} weight="bold" class="-translate-y-0.5 opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
          </a>
        </p>
        <p>Shipping the new site soon.</p>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
