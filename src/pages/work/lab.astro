---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import { SITE_URL } from "@/data/site-config";
---

<BaseLayout
  title="Lab · Northsoon"
  description="Internal R&D at Northsoon. Small experiments in agent tooling and automation for independent operators and small teams."
  canonical={`${SITE_URL}/work/lab`}
>
  <div class="flex min-h-screen flex-col bg-brand-background text-brand-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink />

      <header class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-muted-foreground">
            Work · Lab
          </p>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
            Lab
          </h1>
        </div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-brand-muted-foreground">
          internal
        </span>
      </header>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-brand-muted-foreground">
        <p>
          A small internal R&amp;D effort exploring how independent operators
          and small teams can run coordinated work across multiple AI agents
          without the heavyweight tooling of a large enterprise stack.
        </p>
        <p>
          The premise is simple: a small, custom-tailored agent setup can take
          on real daily load (repetitive tasks, drafting, research, internal
          follow-ups) at a fraction of the cost and complexity that corporate
          platforms demand. Useful leverage for businesses that don't have a
          million-dollar budget to spend on automation.
        </p>
        <p>
          It is not a product. It is a sandbox: we build the parts we need to
          run Northsoon itself, and keep what works.
        </p>
        <p>More to share soon.</p>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
