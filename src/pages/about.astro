---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import ArrowRight from "@northsoon/phosphor-icons-astro/icons/ArrowRight.astro";
import { FOUNDER, CONTACT_EMAIL, SITE_URL } from "@/data/site-config";

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=Northsoon%20%E2%80%94%20Project%20inquiry`;
---

<BaseLayout
  title="About · Northsoon"
  description="Northsoon is an independent studio focused on marketing sites, landing pages, and conversion-focused websites that load fast, read clearly, and age well. Founded by Manuel Caballero."
  canonical={`${SITE_URL}/about`}
>
  <div class="flex min-h-screen flex-col bg-background text-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink />

      <header class="mt-10">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          Northsoon · About
        </p>
        <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
          About
        </h1>
      </header>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-muted-foreground">
        <p>
          Northsoon is an independent studio building websites that load fast,
          read clearly, and age well.
        </p>
        <p>
          We focus on marketing sites, landing pages, and conversion-focused
          websites for businesses that want their online presence done right.
        </p>
        <p>
          We work small on purpose. Every project gets one set of hands from
          start to finish, and undivided attention while it's on the bench.
          The sites we ship favor performance, clarity, and longevity over
          flash.
        </p>
        <p>
          We build with Astro and Tailwind, open-source the small helpers we
          make along the way, and occasionally tinker with internal R&amp;D
          when an idea is worth exploring.
        </p>
        <p class="text-foreground">
          Founded by {FOUNDER.name}. Remote, worldwide. Open for new projects.
        </p>
      </section>

      <section class="mt-16">
        <header class="mb-6 flex items-center gap-4">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
            Get in touch
          </span>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </header>

        <a
          href={mailtoHref}
          class="group inline-flex items-center gap-2 text-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <span class="font-medium">{CONTACT_EMAIL}</span>
          <ArrowRight size={14} weight="bold" class="opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
        </a>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
