---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import ArrowRight from "@northsoon/phosphor-icons-astro/icons/ArrowRight.astro";
import { FOUNDER, CONTACT_EMAIL, SITE_URL } from "@/data/site-config";

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=Northsoon%20%E2%80%94%20Project%20inquiry`;
---

<BaseLayout
  title="About · Northsoon"
  description="Northsoon is an independent studio focused on marketing sites, landing pages, and conversion-focused websites that load fast, read clearly, and age well. Founded by Manuel Caballero."
  canonical={`${SITE_URL}/about`}
>
  <div class="flex min-h-screen flex-col bg-brand-background text-brand-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink />

      <header class="mt-10">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-muted-foreground">
          Northsoon · About
        </p>
        <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
          About
        </h1>
      </header>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-brand-muted-foreground">
        <p>
          Most web projects fail in the same way: a studio takes a brief,
          builds something, delivers it, and disappears. The client is left
          with a site they don't fully understand, can't easily update, and
          that stops evolving the moment the invoice is paid.
        </p>
        <p>
          Northsoon works differently. We partner with founders and small
          teams for the long run — involved in the thinking, not just the
          building. We want to understand your business well enough to push
          back when something won't work and suggest what will.
        </p>
        <p>
          We take on a small number of projects at a time. Not to seem
          exclusive — because it's the only way to do this properly. Every
          project gets our full attention, and every client gets direct
          access to the person doing the work.
        </p>
        <p>
          We build with Astro and Tailwind. The sites we ship are fast,
          maintainable, and designed to stay relevant as your business grows —
          not just to look good on launch day.
        </p>
        <p class="text-brand-foreground">
          Founded by {FOUNDER.name}. Remote, worldwide. Open for new projects.
        </p>
      </section>

      <section class="mt-16">
        <header class="mb-6 flex items-center gap-4">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-muted-foreground">
            Start a project
          </span>
          <span class="h-px flex-1 bg-brand-border" aria-hidden="true"></span>
        </header>

        <p class="mb-6 max-w-sm text-[15px] leading-relaxed text-brand-muted-foreground">
          If this sounds like the kind of partnership you're looking for, let's talk.
        </p>

        <a
          href={mailtoHref}
          class="group inline-flex items-center gap-2 text-brand-foreground transition hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-background"
        >
          <span class="font-medium">{CONTACT_EMAIL}</span>
          <ArrowRight size={14} weight="bold" class="opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
        </a>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
