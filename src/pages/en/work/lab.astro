---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import { useTranslations } from "@/i18n/translations";
import { SITE_URL } from "@/data/site-config";

const t = useTranslations('en');
---

<BaseLayout
  title={`${t('work.lab.h1')} · Northsoon`}
  description={t('work.lab.p1')}
  canonical={`${SITE_URL}/en/work/lab/`}
  lang="en"
  alternates={[
    { hreflang: "es", href: `${SITE_URL}/work/lab/` },
    { hreflang: "en", href: `${SITE_URL}/en/work/lab/` },
    { hreflang: "x-default", href: `${SITE_URL}/work/lab/` },
  ]}
  noindex={true}
>
  <div class="flex min-h-screen flex-col bg-ns-background text-ns-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink href="/en/" label={t('back')} />

      <header class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
            {t('work.lab.breadcrumb')}
          </p>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
            {t('work.lab.h1')}
          </h1>
        </div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-ns-muted-foreground">
          {t('work.lab.status')}
        </span>
      </header>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-ns-muted-foreground">
        <p>{t('work.lab.p1')}</p>
        <p>{t('work.lab.p2')}</p>
        <p>{t('work.lab.p3')}</p>
        <p>{t('work.lab.p4')}</p>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

