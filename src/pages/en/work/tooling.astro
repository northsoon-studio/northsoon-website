---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import ArrowRight from "@northsoon/phosphor-icons-astro/icons/ArrowRight.astro";
import ArrowUpRight from "@northsoon/phosphor-icons-astro/icons/ArrowUpRight.astro";
import { useTranslations } from "@/i18n/translations";
import { PACKAGES } from "@/data/packages";
import { SITE_URL } from "@/data/site-config";

const t = useTranslations('en');
---

<BaseLayout
  title="Open Source · Northsoon"
  description="Astro packages and helpers we use to build fast, maintainable websites with solid SEO."
  canonical={`${SITE_URL}/en/work/tooling/`}
  lang="en"
  alternates={[
    { hreflang: "es", href: `${SITE_URL}/work/tooling/` },
    { hreflang: "en", href: `${SITE_URL}/en/work/tooling/` },
    { hreflang: "x-default", href: `${SITE_URL}/work/tooling/` },
  ]}
>
  <div class="flex min-h-screen flex-col bg-brand-background text-brand-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink href="/en/" label={t('back')} />

      <header class="mt-10">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-muted-foreground">
          {t('work.tooling.breadcrumb')}
        </p>
        <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
          {t('work.tooling.h1')}
        </h1>
      </header>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-brand-muted-foreground">
        <p>{t('work.tooling.intro')}</p>
      </section>

      <section class="mt-12">
        <header class="mb-8 flex items-center gap-4">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-muted-foreground">
            {t('work.tooling.packages')}
          </span>
          <span class="h-px flex-1 bg-brand-border" aria-hidden="true"></span>
        </header>

        <ul class="space-y-10">
          {PACKAGES.map((pkg) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h2 class="font-mono text-sm font-medium text-brand-foreground break-all">
                  {pkg.name}
                </h2>
                <span class="font-mono text-[11px] uppercase tracking-wider text-brand-muted-foreground">
                  {pkg.version}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-brand-muted-foreground">
                {pkg.desc}
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                <a
                  href={pkg.npm}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-brand-muted-foreground transition hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-background"
                >
                  <span>npm</span>
                  <ArrowUpRight size={11} weight="bold" class="opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                </a>
                <a
                  href={pkg.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-brand-muted-foreground transition hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-background"
                >
                  <span>github</span>
                  <ArrowUpRight size={11} weight="bold" class="opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                </a>
                {pkg.name === "@northsoon/astro-seo" && (
                  <a
                    href="/en/open-source/astro-seo/"
                    class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-brand-muted-foreground transition hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-background"
                  >
                    <span>details</span>
                    <ArrowRight size={11} weight="bold" class="opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
