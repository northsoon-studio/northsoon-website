---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ArrowRight from "@northsoon/phosphor-icons-astro/icons/ArrowRight.astro";
import ArrowUpRight from "@northsoon/phosphor-icons-astro/icons/ArrowUpRight.astro";
import { PROJECTS } from "@/data/projects";
import { CONTACT_EMAIL } from "@/data/site-config";

const isExternal = (href: string) => /^(https?:|mailto:)/.test(href);
const isHttpExternal = (href: string) => /^https?:/.test(href);

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=Northsoon%20%E2%80%94%20Project%20inquiry&body=Hi%2C%20I%27d%20like%20to%20talk%20about%20a%20project.`;
---

<BaseLayout>
  <div class="flex min-h-screen flex-col bg-background text-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <section class="mb-12 sm:mb-16">
        <h1 class="font-display text-6xl font-semibold tracking-tight sm:text-7xl">
          Northsoon
        </h1>
        <p class="mt-10 max-w-md text-[15px] leading-relaxed text-muted-foreground">
          Small independent studio building websites that load fast, read
          clearly, and age well.
        </p>
        <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          — Performance · Clarity · Longevity.
        </p>
      </section>

      <section class="mb-20">
        <header class="mb-8 flex items-center gap-4">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
            On the bench
          </span>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </header>

        <ul class="space-y-8">
          {PROJECTS.map((p) => {
            const external = isExternal(p.href);
            const newTab = isHttpExternal(p.href);
            return (
              <li class="grid grid-cols-[2rem_1fr_auto] items-start gap-x-4 sm:gap-x-6">
                <span class="pt-0.5 font-mono text-xs text-muted-foreground" aria-hidden="true">
                  {p.n}
                </span>
                <div class="min-w-0">
                  <a
                    href={p.href}
                    {...(newTab ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="group inline-flex items-center gap-1.5 text-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    <span class="font-medium">{p.name}</span>
                    {external ? (
                      <ArrowUpRight size={12} weight="bold" class="-translate-y-0.5 opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                    ) : (
                      <ArrowRight size={12} weight="bold" class="opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                    )}
                  </a>
                  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                    {p.desc}
                  </p>
                </div>
                <span class="pt-1 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
                  {p.status}
                </span>
              </li>
            );
          })}
        </ul>
      </section>

      <section>
        <header class="mb-6 flex items-center gap-4">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
            Get in touch
          </span>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </header>

        <a
          href={mailtoHref}
          class="group inline-flex items-center gap-2 text-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <span class="font-medium">{CONTACT_EMAIL}</span>
          <ArrowRight size={14} weight="bold" class="opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
        </a>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
