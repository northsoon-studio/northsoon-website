---
import ArrowLeft from "@northsoon/phosphor-icons-astro/icons/ArrowLeft.astro";

interface Props {
  href?: string;
  label?: string;
}

const { href = "/", label = "Back" } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-brand-muted-foreground transition hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-background"
>
  <ArrowLeft size={12} weight="bold" class="transition group-hover:-translate-x-0.5" />
  <span>{label}</span>
</a>
