---
import { FOUNDER } from "@/data/site-config";

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-xl px-6 py-8">
  <p class="text-center font-mono text-[11px] text-brand-muted-foreground">
    © {year} Northsoon ·{" "}
    <a
      href={FOUNDER.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="text-brand-foreground underline decoration-brand-border underline-offset-4 transition hover:text-brand-primary hover:decoration-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-background"
    >
      {FOUNDER.name}
    </a>
  </p>
</footer>
