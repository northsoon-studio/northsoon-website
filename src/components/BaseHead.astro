---
import "../styles/global.css";
import { AstroHead } from "@northsoon/astro-seo";
import type { JsonLdObject } from "@northsoon/astro-seo";
import {
  SITE_URL,
  DEFAULT_SEO,
  SOCIAL,
  JSON_LD,
  ADDITIONAL_LINK_TAGS,
  ADDITIONAL_META_TAGS,
} from "@/data/site-config";

type AlternateLink = {
  hreflang: string;
  href: string;
};

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  alternates?: AlternateLink[];
  noindex?: boolean;
  nofollow?: boolean;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const {
  title = DEFAULT_SEO.title,
  description = DEFAULT_SEO.description,
  canonical = `${SITE_URL}/`,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_SEO.ogImage,
  alternates = [],
  noindex = false,
  nofollow = false,
  jsonLd = JSON_LD,
} = Astro.props;

const twitter = SOCIAL.twitterHandle
  ? {
      handle: SOCIAL.twitterHandle,
      site: SOCIAL.twitterHandle,
      cardType: "summary_large_image" as const,
    }
  : {
      cardType: "summary_large_image" as const,
    };
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<AstroHead
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  nofollow={nofollow}
  openGraph={{
    url: canonical,
    type: "website",
    title: ogTitle,
    description: ogDescription,
    site_name: "Northsoon",
    images: [{ url: ogImage, ...(ogImage === DEFAULT_SEO.ogImage ? { width: 1500, height: 500 } : {}) }],
  }}
  twitter={twitter}
  languageAlternates={alternates}
  additionalLinkTags={ADDITIONAL_LINK_TAGS}
  additionalMetaTags={ADDITIONAL_META_TAGS}
  jsonLd={jsonLd}
/>

<script is:inline>
  (() => {
    const stored = localStorage.getItem("theme");
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    if (stored === "dark" || (!stored && prefersDark)) {
      document.documentElement.classList.add("dark");
    }
  })();
</script>
