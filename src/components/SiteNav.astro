---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Sun from "@northsoon/phosphor-icons-astro/icons/Sun.astro";
import Moon from "@northsoon/phosphor-icons-astro/icons/Moon.astro";
import Logo from "@/components/Logo.astro";
import { useTranslations } from "@/i18n/translations";
import type { Locale } from "@/i18n/translations";

interface Props {
  alternatePath?: string;
}

const { alternatePath } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const aboutHref = getRelativeLocaleUrl(locale, 'about');
const homeHref = getRelativeLocaleUrl(locale, '');
const contactHref = `${homeHref}#contact`;

const pathname = Astro.url.pathname;
const alternateLang = locale === 'es' ? 'en' : 'es';
const canonicalPath = locale === 'en' ? (pathname.replace(/^\/en/, '') || '/') : pathname;
const alternateHref = getRelativeLocaleUrl(alternateLang, alternatePath ?? canonicalPath);
---

<nav aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'} class="mx-auto flex w-full max-w-xl items-center justify-between px-6 py-5">
  <a href={homeHref} class="inline-flex items-center" aria-label="Northsoon home">
    <Logo class="size-10" />
  </a>

  <div class="flex items-center gap-3 sm:gap-5">
    <a
      href={aboutHref}
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground transition hover:text-ns-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ns-primary focus-visible:ring-offset-2 focus-visible:ring-offset-ns-background"
    >
      {t('nav.about')}
    </a>

    <a
      href={contactHref}
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground transition hover:text-ns-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ns-primary focus-visible:ring-offset-2 focus-visible:ring-offset-ns-background"
    >
      {t('nav.contact')}
    </a>

    <a
      href={alternateHref}
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground transition hover:text-ns-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ns-primary focus-visible:ring-offset-2 focus-visible:ring-offset-ns-background"
      aria-label={locale === 'es' ? 'Switch to English' : 'Cambiar a Español'}
    >
      {t('nav.lang')}
    </a>

    <button
      id="theme-toggle"
      type="button"
      aria-label={locale === 'es' ? 'Cambiar tema de color' : 'Toggle color theme'}
      aria-pressed="false"
      class="inline-flex size-9 items-center justify-center rounded-md bg-ns-background text-ns-muted-foreground transition pointer-fine:hover:bg-ns-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ns-primary focus-visible:ring-offset-2 focus-visible:ring-offset-ns-background"
    >
      <Sun size={16} weight="bold" class="hidden dark:block text-solar-400" />
      <Moon size={16} weight="bold" class="dark:hidden text-north-400" />
    </button>
  </div>
</nav>

<script is:inline>
  const btn = document.getElementById("theme-toggle");
  const isDarkOnLoad = document.documentElement.classList.contains("dark");
  btn?.setAttribute("aria-pressed", String(isDarkOnLoad));
  btn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    btn.setAttribute("aria-pressed", String(isDark));
  });
</script>

