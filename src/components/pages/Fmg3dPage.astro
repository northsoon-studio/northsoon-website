---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "@/i18n/translations";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BackLink from "@/components/BackLink.astro";
import ArrowUpRight from "@northsoon/phosphor-icons-astro/icons/ArrowUpRight.astro";
import { useTranslations } from "@/i18n/translations";
import { SITE_URL } from "@/data/site-config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  title={`${t("work.fmg3d.h1")} · Northsoon`}
  description={t("work.fmg3d.p1")}
  canonical={new URL(getRelativeLocaleUrl(locale, "work/fmg3d"), SITE_URL).href}
  lang={locale}
  alternates={[
    { hreflang: "es", href: `${SITE_URL}/work/fmg3d/` },
    { hreflang: "en", href: `${SITE_URL}/en/work/fmg3d/` },
    { hreflang: "x-default", href: `${SITE_URL}/work/fmg3d/` },
  ]}
>
  <div class="flex min-h-screen flex-col bg-ns-background text-ns-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <BackLink href={getRelativeLocaleUrl(locale, "")} label={t("back")} />

      <header class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
            {t("work.fmg3d.breadcrumb")}
          </p>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight sm:text-6xl">
            {t("work.fmg3d.h1")}
          </h1>
        </div>
        <span class="font-mono text-[11px] uppercase tracking-wider text-ns-muted-foreground">
          {t("work.fmg3d.status")}
        </span>
      </header>

      <figure class="mt-10 overflow-hidden border border-ns-border bg-ns-muted">
        <img
          src="/fmg3d-site-preview.png"
          alt={t("work.fmg3d.imageAlt")}
          width="1521"
          height="722"
          loading="eager"
          class="w-full"
        />
      </figure>

      <section class="mt-12 space-y-6 text-[15px] leading-relaxed text-ns-muted-foreground">
        <p>{t("work.fmg3d.p1")}</p>
        <section>
          <h2 class="mb-2 font-medium text-ns-foreground">{t("work.fmg3d.need")}</h2>
          <p>{t("work.fmg3d.p2")}</p>
        </section>
        <section>
          <h2 class="mb-2 font-medium text-ns-foreground">{t("work.fmg3d.work")}</h2>
          <p>{t("work.fmg3d.p3")}</p>
        </section>
        <section>
          <h2 class="mb-2 font-medium text-ns-foreground">{t("work.fmg3d.delivery")}</h2>
          <p>{t("work.fmg3d.p4")}</p>
        </section>
        <p>
          <a href="https://fmg3d.cl/" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 text-ns-foreground transition hover:text-ns-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ns-primary focus-visible:ring-offset-2 focus-visible:ring-offset-ns-background">
            <span class="font-medium">{t("work.fmg3d.link")}</span>
            <ArrowUpRight size={12} weight="bold" class="-translate-y-0.5 opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
          </a>
        </p>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
