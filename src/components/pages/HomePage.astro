---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "@/i18n/translations";
import WhatsAppLink from "@/components/WhatsAppLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ArrowRight from "@northsoon/phosphor-icons-astro/icons/ArrowRight.astro";
import ArrowUpRight from "@northsoon/phosphor-icons-astro/icons/ArrowUpRight.astro";
import { useTranslations, projects } from "@/i18n/translations";
import { SITE_URL } from "@/data/site-config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const PROJECTS = projects[locale];

const isExternal = (href: string) => /^(https?:|mailto:)/.test(href);
const isHttpExternal = (href: string) => /^https?:/.test(href);

---

<BaseLayout
  title={t("seo.home.title")}
  description={t("seo.home.desc")}
  canonical={new URL(getRelativeLocaleUrl(locale, ""), SITE_URL).href}
  lang={locale}
  alternates={[
    { hreflang: "es", href: `${SITE_URL}/` },
    { hreflang: "en", href: `${SITE_URL}/en/` },
    { hreflang: "x-default", href: `${SITE_URL}/` },
  ]}
>
  <div class="flex min-h-screen flex-col bg-ns-background text-ns-foreground">
    <SiteNav />

    <main class="mx-auto w-full max-w-xl flex-1 px-6 pb-16 pt-10 sm:pt-20">
      <section class="mb-16 sm:mb-20">
        <h1 class="font-display text-6xl font-semibold tracking-tight sm:text-7xl">
          Northsoon
        </h1>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-ns-muted-foreground">
          {t("hero.description")}
        </p>
        <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
          {t("hero.subtitle")}
        </p>
        <WhatsAppLink locale={locale} class="mt-6 min-h-11" />
      </section>

      <section class="mb-20">
        <header class="mb-8 flex items-center gap-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
            {t("section.help")}
          </h2>
          <span class="h-px flex-1 bg-ns-border" aria-hidden="true"></span>
        </header>

        <ul class="space-y-8">
          {[
            { n: "01", title: t("help.1.title"), desc: t("help.1.desc") },
            { n: "02", title: t("help.2.title"), desc: t("help.2.desc") },
            { n: "03", title: t("help.3.title"), desc: t("help.3.desc") },
            { n: "04", title: t("help.4.title"), desc: t("help.4.desc") },
          ].map((item) => (
            <li class="grid grid-cols-[2rem_1fr] items-start gap-x-4 sm:gap-x-6">
              <span class="pt-0.5 font-mono text-xs text-ns-muted-foreground" aria-hidden="true">{item.n}</span>
              <div class="min-w-0">
                <p class="font-medium text-ns-foreground">{item.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-ns-muted-foreground">{item.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-20">
        <header class="mb-8 flex items-center gap-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
            {t("section.how")}
          </h2>
          <span class="h-px flex-1 bg-ns-border" aria-hidden="true"></span>
        </header>

        <ul class="space-y-8">
          <li class="grid grid-cols-[2rem_1fr] items-start gap-x-4 sm:gap-x-6">
            <span class="pt-0.5 font-mono text-xs text-ns-muted-foreground" aria-hidden="true">01</span>
            <div class="min-w-0">
              <p class="font-medium text-ns-foreground">{t("how.1.title")}</p>
              <p class="mt-1 text-sm leading-relaxed text-ns-muted-foreground">{t("how.1.desc")}</p>
            </div>
          </li>
          <li class="grid grid-cols-[2rem_1fr] items-start gap-x-4 sm:gap-x-6">
            <span class="pt-0.5 font-mono text-xs text-ns-muted-foreground" aria-hidden="true">02</span>
            <div class="min-w-0">
              <p class="font-medium text-ns-foreground">{t("how.2.title")}</p>
              <p class="mt-1 text-sm leading-relaxed text-ns-muted-foreground">{t("how.2.desc")}</p>
            </div>
          </li>
          <li class="grid grid-cols-[2rem_1fr] items-start gap-x-4 sm:gap-x-6">
            <span class="pt-0.5 font-mono text-xs text-ns-muted-foreground" aria-hidden="true">03</span>
            <div class="min-w-0">
              <p class="font-medium text-ns-foreground">{t("how.3.title")}</p>
              <p class="mt-1 text-sm leading-relaxed text-ns-muted-foreground">{t("how.3.desc")}</p>
            </div>
          </li>
        </ul>
      </section>

      <section class="mb-20">
        <header class="mb-8 flex items-center gap-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
            {t("section.work")}
          </h2>
          <span class="h-px flex-1 bg-ns-border" aria-hidden="true"></span>
        </header>

        <ul class="space-y-8">
          {PROJECTS.map((p) => {
            const external = isExternal(p.href);
            const newTab = isHttpExternal(p.href);
            return (
              <li class="grid grid-cols-[2rem_1fr_auto] items-start gap-x-4 sm:gap-x-6">
                <span class="pt-0.5 font-mono text-xs text-ns-muted-foreground" aria-hidden="true">
                  {p.n}
                </span>
                <div class="min-w-0">
                  <a
                    href={p.href}
                    {...(newTab ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="group inline-flex items-center gap-1.5 text-ns-foreground transition hover:text-ns-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ns-primary focus-visible:ring-offset-2 focus-visible:ring-offset-ns-background"
                  >
                    <span class="font-medium">{p.name}</span>
                    {external ? (
                      <ArrowUpRight size={12} weight="bold" class="-translate-y-0.5 opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                    ) : (
                      <ArrowRight size={12} weight="bold" class="opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                    )}
                  </a>
                  <p class="mt-1 text-sm leading-relaxed text-ns-muted-foreground">
                    {p.desc}
                  </p>
                </div>
                <span class="pt-1 font-mono text-[11px] uppercase tracking-wider text-ns-muted-foreground">
                  {p.status}
                </span>
              </li>
            );
          })}
        </ul>
      </section>


      <section>
        <header class="mb-6 flex items-center gap-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ns-muted-foreground">
            {t("section.cta")}
          </h2>
          <span class="h-px flex-1 bg-ns-border" aria-hidden="true"></span>
        </header>

        <p class="mb-2 font-medium text-ns-foreground">{t("cta.title")}</p>
        <p class="mb-6 max-w-sm text-[15px] leading-relaxed text-ns-muted-foreground">
          {t("cta.desc")}
        </p>

        <WhatsAppLink locale={locale} />
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
