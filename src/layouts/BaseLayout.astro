---
import BaseHead from "@/components/BaseHead.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import type { JsonLdObject } from "@northsoon/astro-seo";

type AlternateLink = {
  hreflang: string;
  href: string;
};

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  lang?: string;
  alternates?: AlternateLink[];
  noindex?: boolean;
  nofollow?: boolean;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  lang = "es",
  alternates = [],
  noindex = false,
  nofollow = false,
  jsonLd,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      alternates={alternates}
      noindex={noindex}
      nofollow={nofollow}
      jsonLd={jsonLd}
    />
    <SpeedInsights />
    <Analytics />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
